# Concentrate AI API (required)
CONCENTRATE_API_KEY=your_api_key_here

# Optional: override base URL (default: https://api.concentrate.ai)
# CONCENTRATE_BASE_URL=https://api.concentrate.ai

# Optional: model IDs (defaults shown)
# OPENAI_MODEL=openai/gpt-5.2
# ANTHROPIC_MODEL=anthropic/claude-opus-4-6

# Optional: request timeout in seconds (default: 60)
# REQUEST_TIMEOUT_SECONDS=60
